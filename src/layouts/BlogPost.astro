---
import PageLayout from './PageLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
}

const { locale, title, description, pubDate, updatedDate, heroImage } = Astro.props;
const t = useTranslations(locale);
---

<PageLayout locale={locale} title={title} description={description} image={heroImage}>
	<article class="blog-article">
		{heroImage && (
			<div class="hero-image">
				<img width={1020} height={510} src={heroImage} alt="" />
			</div>
		)}
		<div class="prose">
			<div class="title">
				<div class="date">
					<FormattedDate date={pubDate} locale={locale} />
					{
						updatedDate && (
							<div class="last-updated-on">
								{t('post.updated')}: <FormattedDate date={updatedDate} locale={locale} />
							</div>
						)
					}
				</div>
				<h1>{title}</h1>
				<hr />
			</div>
			<slot />
		</div>
	</article>
</PageLayout>

<style>
	.blog-article {
		width: 100%;
	}

	.hero-image img {
		display: block;
		margin: 0 auto 1.5rem;
		max-width: 100%;
		border-radius: 12px;
		box-shadow: var(--lift);
	}

	.prose {
		width: min(var(--prose-max), 100%);
		margin: 0 auto;
		color: var(--ink);
	}

	.title {
		margin-bottom: 1.5em;
		text-align: center;
	}

	.title h1 {
		margin-top: 0.5rem;
	}

	.date {
		color: var(--ink-soft);
		font-size: 0.95rem;
	}

	.last-updated-on {
		font-style: italic;
		margin-top: 0.25rem;
	}
</style>
