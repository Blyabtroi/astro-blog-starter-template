---
import PageLayout from './PageLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
}

const { locale, title, description, pubDate, updatedDate, heroImage } = Astro.props;
const t = useTranslations(locale);
---

<PageLayout locale={locale} title={title} description={description} image={heroImage}>
	<style slot="head">
		main {
			width: calc(100% - 2em);
			max-width: 100%;
		}
		.hero-image img {
			display: block;
			margin: 0 auto 1.5rem;
			max-width: 100%;
			border-radius: 12px;
			box-shadow: var(--box-shadow);
		}
		.prose {
			width: 720px;
			max-width: calc(100% - 2em);
			margin: auto;
			padding: 0 1em;
			color: rgb(var(--gray-dark));
		}
		.title {
			margin-bottom: 1em;
			text-align: center;
		}
		.date {
			color: rgb(var(--gray));
		}
		.last-updated-on {
			font-style: italic;
		}
	</style>
	<article>
		{heroImage && (
			<div class="hero-image">
				<img width={1020} height={510} src={heroImage} alt="" />
			</div>
		)}
		<div class="prose">
			<div class="title">
				<div class="date">
					<FormattedDate date={pubDate} locale={locale} />
					{
						updatedDate && (
							<div class="last-updated-on">
								{t('post.updated')}: <FormattedDate date={updatedDate} locale={locale} />
							</div>
						)
					}
				</div>
				<h1>{title}</h1>
				<hr />
			</div>
			<slot />
		</div>
	</article>
</PageLayout>
