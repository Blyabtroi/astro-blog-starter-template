---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const today = new Date();
---

<footer class="site-footer">
	<p class="site-footer__copy">
		&copy; {today.getFullYear()} Vasiliy (Basil) Kozlov. {t('footer.rights')}
	</p>
	<div class="site-footer__links">
		<a href="https://twitter.com/blyabtroi" target="_blank" rel="noopener noreferrer">Twitter</a>
		<a href="https://github.com/blyabtroi" target="_blank" rel="noopener noreferrer">GitHub</a>
	</div>
</footer>

<style>
	.site-footer {
		max-width: var(--content-max);
		margin: 0 auto;
		padding: 2rem 1rem 4rem;
		text-align: center;
		color: var(--ink-soft);
		font-size: 0.95rem;
		border-top: 1px solid var(--line);
	}

	.site-footer__copy {
		margin: 0 0 0.75rem;
	}

	.site-footer__links {
		display: flex;
		justify-content: center;
		gap: 1.25rem;
	}

	.site-footer__links a {
		color: var(--ink-soft);
		text-decoration: none;
	}

	.site-footer__links a:hover {
		color: var(--accent);
	}
</style>
