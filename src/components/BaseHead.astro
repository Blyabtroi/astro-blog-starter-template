---
import '../styles/global.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import type { Locale } from '../i18n/ui';
import { stripEnPrefix } from '../i18n/ui';

interface Props {
	title: string;
	description: string;
	image?: string;
	locale: Locale;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = '/favicon.svg', locale } = Astro.props;

const neutralPath = stripEnPrefix(Astro.url.pathname);
const ruUrl = getAbsoluteLocaleUrl('ru', neutralPath);
const enUrl = getAbsoluteLocaleUrl('en', neutralPath);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="ru" href={ruUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={ruUrl} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
