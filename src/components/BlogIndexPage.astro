---
import PageLayout from '../layouts/PageLayout.astro';
import FormattedDate from './FormattedDate.astro';
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { blogPostUrl, postSlug } from '../lib/blog';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = (await getCollection('blog', ({ data }) => data.locale === locale)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<PageLayout locale={locale} title={t('blog.title')} description={t('blog.lead')}>
	<h1>{t('blog.title')}</h1>
	<p class="lead">{t('blog.lead')}</p>
	<ul class="post-list">
		{
			posts.map((post) => (
				<li>
					<a href={blogPostUrl(locale, postSlug(post))}>
						<h2>{post.data.title}</h2>
						<p class="desc">{post.data.description}</p>
						<FormattedDate date={post.data.pubDate} locale={locale} />
					</a>
				</li>
			))
		}
	</ul>
</PageLayout>

<style>
	.lead {
		color: var(--ink-soft);
		max-width: 40rem;
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 2rem 0 0;
	}

	.post-list li {
		margin-bottom: 1.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--line);
	}

	.post-list a {
		text-decoration: none;
		color: inherit;
	}

	.post-list h2 {
		margin: 0 0 0.35rem;
		font-size: 1.35rem;
	}

	.post-list a:hover h2 {
		color: var(--accent);
	}

	.desc {
		margin: 0 0 0.5rem;
		color: var(--ink-soft);
		font-size: 0.98rem;
	}
</style>
