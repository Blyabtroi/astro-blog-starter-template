---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../i18n/ui';
import { stripEnPrefix, useTranslations } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const otherLocale: Locale = locale === 'ru' ? 'en' : 'ru';
const neutralPath = stripEnPrefix(Astro.url.pathname);
const switchUrl = getRelativeLocaleUrl(otherLocale, neutralPath);
---

<a class="lang-switch" href={switchUrl} hreflang={otherLocale} rel="alternate">
	{t('lang.switch')}
</a>

<style>
	.lang-switch {
		font-size: 0.85rem;
		padding: 0.45rem 0.65rem;
		border: 1px solid var(--line);
		border-radius: 8px;
		white-space: nowrap;
		text-decoration: none;
		color: var(--ink);
	}

	.lang-switch:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
</style>
