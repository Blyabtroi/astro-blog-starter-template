---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const hrefStr = typeof href === 'string' ? href : href?.toString() ?? '';

function normalize(path: string) {
	if (path.length > 1 && path.endsWith('/')) return path.slice(0, -1);
	return path;
}

const isActive =
	normalize(pathname) === normalize(hrefStr) ||
	(hrefStr !== '/' && pathname.startsWith(hrefStr.endsWith('/') ? hrefStr : `${hrefStr}/`));
---

<a href={href} class:list={['nav-link', className, { active: isActive }]} {...props}>
	<slot />
</a>

<style>
	.nav-link {
		display: inline-block;
		padding: 0.35rem 0.5rem;
		font-size: 0.95rem;
		text-decoration: none;
		color: var(--ink-soft);
		border-radius: 6px;
	}

	.nav-link:hover {
		color: var(--accent);
		background: var(--panel);
	}

	.nav-link.active {
		color: var(--accent);
		font-weight: 600;
	}
</style>
