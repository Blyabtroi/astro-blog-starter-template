---
import HeaderLink from './HeaderLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = getRelativeLocaleUrl(locale, '/');
const projects = getRelativeLocaleUrl(locale, '/projects');
const blog = getRelativeLocaleUrl(locale, '/blog');
const about = getRelativeLocaleUrl(locale, '/about');
---

<header class="site-header">
	<nav class="site-header__nav">
		<a class="site-header__brand" href={home}>
			{SITE_TITLE}
		</a>
		<div class="site-header__links">
			<HeaderLink href={home}>{t('nav.home')}</HeaderLink>
			<HeaderLink href={projects}>{t('nav.projects')}</HeaderLink>
			<HeaderLink href={blog}>{t('nav.blog')}</HeaderLink>
			<HeaderLink href={about}>{t('nav.about')}</HeaderLink>
		</div>
		<div class="site-header__controls">
			<ThemeToggle locale={locale} />
			<LanguageSwitcher locale={locale} />
			<a
				class="site-header__social"
				href="https://www.linkedin.com/in/vasiliy-kozlov"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="LinkedIn"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22"
					><path
						fill="currentColor"
						d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in oklab, var(--bg) 92%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line);
		padding: 0 1rem;
	}

	.site-header__nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		max-width: var(--content-max);
		margin: 0 auto;
		min-height: 3.5rem;
	}

	.site-header__brand {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1rem;
		text-decoration: none;
		color: var(--ink);
		letter-spacing: -0.02em;
	}

	.site-header__brand:hover {
		color: var(--accent);
	}

	.site-header__links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.5rem;
	}

	.site-header__controls {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.site-header__social {
		display: flex;
		color: var(--ink-soft);
	}

	.site-header__social:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.site-header__links {
			order: 3;
			width: 100%;
			padding-bottom: 0.5rem;
		}
	}
</style>
