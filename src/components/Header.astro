---
import HeaderLink from './HeaderLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = getRelativeLocaleUrl(locale, '/');
const projects = getRelativeLocaleUrl(locale, '/projects');
const blog = getRelativeLocaleUrl(locale, '/blog');
const about = getRelativeLocaleUrl(locale, '/about');
---

<header class="site-header">
	<nav class="site-header__nav">
		<a class="site-header__brand" href={home}>
			{SITE_TITLE}
		</a>
		<div class="site-header__links">
			<HeaderLink href={home}>{t('nav.home')}</HeaderLink>
			<HeaderLink href={projects}>{t('nav.projects')}</HeaderLink>
			<HeaderLink href={blog}>{t('nav.blog')}</HeaderLink>
			<HeaderLink href={about}>{t('nav.about')}</HeaderLink>
		</div>
		<div class="site-header__controls">
			<ThemeToggle locale={locale} />
			<LanguageSwitcher locale={locale} />
			<a
				class="site-header__social"
				href="https://github.com/blyabtroi"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub"
			>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in oklab, var(--bg) 92%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line);
		padding: 0 1rem;
	}

	.site-header__nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		max-width: var(--content-max);
		margin: 0 auto;
		min-height: 3.5rem;
	}

	.site-header__brand {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1rem;
		text-decoration: none;
		color: var(--ink);
		letter-spacing: -0.02em;
	}

	.site-header__brand:hover {
		color: var(--accent);
	}

	.site-header__links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.5rem;
	}

	.site-header__controls {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.site-header__social {
		display: flex;
		color: var(--ink-soft);
	}

	.site-header__social:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.site-header__links {
			order: 3;
			width: 100%;
			padding-bottom: 0.5rem;
		}
	}
</style>
