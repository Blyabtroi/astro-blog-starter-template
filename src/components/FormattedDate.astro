---
import type { Locale } from '../i18n/ui';

interface Props {
	date: Date;
	locale?: Locale;
}

const { date, locale = 'ru' } = Astro.props;
const tag = locale === 'en' ? 'en-US' : 'ru-RU';
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString(tag, { year: 'numeric', month: 'short', day: 'numeric' })}
</time>
