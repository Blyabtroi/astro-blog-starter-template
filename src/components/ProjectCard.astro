---
import type { Project } from '../data/projects';
import { isAppStoreUrl, projectHref } from '../data/projects';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
	project: Project;
	locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);
const href = projectHref(project, locale);
const isExternal = Boolean(project.externalUrl);
const ctaLabel = isExternal
	? isAppStoreUrl(href)
		? t('projects.appStore')
		: t('projects.external')
	: project.blogSlug
		? t('projects.article')
		: t('projects.open');
---

<article class:list={['project-card', project.cardArt && 'project-card--art']}>
	{
		project.cardArt && (
			<div class="project-card__art" aria-hidden="true">
				<img src={project.cardArt} alt="" loading="lazy" decoding="async" />
			</div>
		)
	}
	<div class="project-card__body">
	<h3>
		<a
			href={href}
			target={isExternal ? '_blank' : undefined}
			rel={isExternal ? 'noopener noreferrer' : undefined}>{project.title[locale]}</a
		>
	</h3>
	<p>{project.description[locale]}</p>
	{
		project.tags.length > 0 && (
			<ul class="tags">
				{project.tags.map((tag) => (
					<li>{tag}</li>
				))}
			</ul>
		)
	}
	<p class="cta">
		<a
			href={href}
			target={isExternal ? '_blank' : undefined}
			rel={isExternal ? 'noopener noreferrer' : undefined}
		>
			{ctaLabel} →
		</a>
	</p>
	</div>
</article>

<style>
	.project-card {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 12px;
		padding: 1.25rem 1.35rem;
		background: var(--panel);
		transition:
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	.project-card__body {
		position: relative;
		z-index: 1;
	}

	.project-card__art {
		position: absolute;
		inset: 0;
		pointer-events: none;
		border-radius: inherit;
		overflow: hidden;
	}

	.project-card__art img {
		position: absolute;
		right: -4%;
		bottom: -6%;
		width: min(58%, 280px);
		max-height: 92%;
		object-fit: contain;
		object-position: bottom right;
		opacity: 0.5;
		-webkit-mask-image: linear-gradient(
			to top left,
			rgba(0, 0, 0, 0.95) 0%,
			rgba(0, 0, 0, 0.35) 42%,
			transparent 68%
		);
		mask-image: linear-gradient(
			to top left,
			rgba(0, 0, 0, 0.95) 0%,
			rgba(0, 0, 0, 0.35) 42%,
			transparent 68%
		);
	}

	.project-card:hover {
		box-shadow: var(--lift);
		border-color: color-mix(in oklab, var(--accent) 35%, var(--line));
	}

	.project-card h3 {
		margin: 0 0 0.5rem;
		font-size: 1.15rem;
	}

	.project-card h3 a {
		color: var(--ink);
		text-decoration: none;
	}

	.project-card h3 a:hover {
		color: var(--accent);
	}

	.project-card p {
		margin: 0.5rem 0;
		color: var(--ink-soft);
		font-size: 0.98rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0.75rem 0 0;
		font-size: 0.8rem;
		color: var(--ink-soft);
	}

	.cta {
		margin-top: 1rem;
	}

	.cta a {
		font-weight: 600;
		text-decoration: none;
	}

	.cta a:hover {
		text-decoration: underline;
	}
</style>
